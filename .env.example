# Bu faylni nusxalab ".env" deb nomlang va qiymatlarni to'ldiring

# @BotFather -> /mybots -> bot -> API Token
BOT_TOKEN=

# Sizning Telegram ID'ingiz (@userinfobot dan bilib olasiz). Bir nechta bo'lsa: 111,222
ADMIN_IDS=

# Ixtiyoriy: Click/Payme orqali to'lov (@BotFather -> Payments). Bo'sh qolsa faqat karta orqali to'lov ishlaydi
PAYMENT_PROVIDER_TOKEN=

# Karta orqali to'lov uchun
CARD_NUMBER=8600 0000 0000 0000
CARD_HOLDER=ISM FAMILIYA

# Ixtiyoriy: yordam uchun username (@ belgisisiz)
SUPPORT_USERNAME=

DB_PATH=esim.db

# Mini App
WEB_PORT=8080
# HTTPS manzil (cloudflared yoki server domeni). Bo'sh qolsa Mini App tugmasi chiqmaydi
WEBAPP_URL=

# Trip.com avto-xarid (README'ga qarang)
TRIP_AUTOBUY=1
TRIP_DAILY_LIMIT=100
TRIP_PRICE_TOLERANCE=1.3

# Bot username (@ belgisisiz) — PDF vaucherdagi QR va havola uchun
BOT_USERNAME=Booking_eSIM_bot

# Onlayn to'lov (@BotFather -> /mybots -> bot -> Payments): Click va Payme uchun alohida tokenlar
CLICK_PROVIDER_TOKEN=
PAYME_PROVIDER_TOKEN=
